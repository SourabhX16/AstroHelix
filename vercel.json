{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "api.app:app",
      "routes": [
        {
          "src": "/api/agent/(.*)",
          "transforms": [
            {
              "type": "request.path",
              "op": "set",
              "args": "/agent/$1"
            }
          ]
        }
      ],
      "functions": {
        "api/app.py": {
          "maxDuration": "max",
          "excludeFiles": "{frontend/**,scripts/**,outputs/**,**/*.md}"
        }
      }
    },
    "frontend": {
      "root": "frontend",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/agent/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}

# Select openai_compat for an OpenAI-compatible endpoint or scripted for offline tests.
LLM_PROVIDER=openai_compat

# Option 1: NVIDIA hosted API
# Base URL: https://integrate.api.nvidia.com/v1; get a key from build.nvidia.com.
# Use the model ID in the NVIDIA_NIM preset in agents/config.py.
# Set NEMOTRON_DISABLE_THINKING=false if the API rejects the extra parameter.
# Option 2: Any OpenAI-compatible provider that supports TOOL/FUNCTION CALLING.
# Option 3: LLM_PROVIDER=scripted (no model and no key required).
NEMOTRON_BASE_URL=http://localhost:8001/v1
NEMOTRON_API_KEY=replace-with-your-api-key
NEMOTRON_MODEL=replace-with-model-id
NEMOTRON_TEMPERATURE=0.3
NEMOTRON_MAX_TOKENS=2048
NEMOTRON_DISABLE_THINKING=true

AGENT_API_URL=http://localhost:8000
LLM_API_URL=http://localhost:8001
